{
  "manifest_version": 3,
  "name": "AuthBaton Chrome Sync",
  "version": "0.1.0",
  "description": "Optional AuthBaton companion extension: sync claude.ai web login in Chrome, reset Claude in Chrome session, and auto-approve OAuth during an AuthBaton switch.",
  "key": "",
  "permissions": [
    "cookies",
    "browsingData",
    "management",
    "nativeMessaging",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*"
  ],
  "action": {
    "default_title": "AuthBaton Chrome Sync",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/oauth/authorize*"
      ],
      "js": [
        "oauth-auto-approve.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
